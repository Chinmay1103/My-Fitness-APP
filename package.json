{
  "name": "my-fitness-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspace @fitness/scoring && npm run test --workspace web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mobile": "npm run start --workspace mobile",
    "mobile:go": "npm run start --workspace mobile -- --go",
    "web": "npm run dev --workspace web",
    "web:build": "npm run build --workspace web",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "supabase": "^2.118.0"
  }
}
